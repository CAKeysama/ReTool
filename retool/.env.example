# Copie para .env e preencha com a configuração web do Firebase
# (Console → Configurações do projeto → Seus apps → Configuração do SDK).
# Documentação: https://github.com/CAKeysama/ReTool/wiki/Configuração-do-Ambiente

# true = usa o projeto de fallback (variáveis VITE_FIREBASE_FALLBACK_*)
VITE_USE_FALLBACK_DB=false

# Projeto principal
VITE_FIREBASE_API_KEY=seu_valor_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_valor_aqui
VITE_FIREBASE_APP_ID=seu_valor_aqui
VITE_FIREBASE_MEASUREMENT_ID=seu_valor_aqui

# Projeto de fallback
VITE_FIREBASE_FALLBACK_API_KEY=seu_valor_aqui
VITE_FIREBASE_FALLBACK_AUTH_DOMAIN=seu-projeto-fallback.firebaseapp.com
VITE_FIREBASE_FALLBACK_PROJECT_ID=seu-projeto-fallback
VITE_FIREBASE_FALLBACK_STORAGE_BUCKET=seu-projeto-fallback.appspot.com
VITE_FIREBASE_FALLBACK_MESSAGING_SENDER_ID=seu_valor_aqui
VITE_FIREBASE_FALLBACK_APP_ID=seu_valor_aqui
VITE_FIREBASE_FALLBACK_MEASUREMENT_ID=seu_valor_aqui
