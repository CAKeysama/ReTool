rules_version = '2';

// =====================================================================
// ReTool — Regras de Segurança do Firestore (RBAC server-side)
// =====================================================================
// O controle de acesso é aplicado NO SERVIDOR: nenhum cliente consegue
// elevar o próprio perfil, editar dados de terceiros ou apagar auditoria
// burlando a interface — toda escrita é validada aqui contra o perfil
// persistido na coleção `users`.
//
// Perfis (ver src/domain/entities/user.ts):
//   admin      -> acesso total + gestão de usuários + auditoria
//   projetista -> cadastra/edita/aprova, NUNCA exclui
//   engenharia -> consulta + solicita reutilizações
//   gerencia   -> somente leitura + consulta de auditoria
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------- FUNÇÕES AUXILIARES ----------------------

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Usuário possui perfil ativo no sistema?
    function isActiveUser(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && userDoc(uid).ativo == true;
    }

    function isAdmin() {
      return isActiveUser(request.auth.uid)
        && userDoc(request.auth.uid).perfil == 'admin';
    }

    // Papéis com permissão de escrita nas coleções industriais
    function canCadastrar() {
      return isActiveUser(request.auth.uid)
        && userDoc(request.auth.uid).perfil in ['admin', 'projetista'];
    }

    function canEditar() {
      return canCadastrar();
    }

    // Exclusão é prerrogativa exclusiva da Administração (com auditoria)
    function canExcluir() {
      return isAdmin();
    }

    function canAprovar() {
      return isActiveUser(request.auth.uid)
        && userDoc(request.auth.uid).perfil in ['admin', 'projetista'];
    }

    function canSolicitar() {
      return isActiveUser(request.auth.uid)
        && userDoc(request.auth.uid).perfil in ['admin', 'projetista', 'engenharia'];
    }

    // ------------------------- USUÁRIOS -----------------------------

    match /users/{userId} {
      // Qualquer autenticado consulta a lista (necessário p/ UI de gestão
      // e auditoria; a escrita é estritamente controlada abaixo).
      allow get, list: if signedIn();

      allow create: if signedIn()
        // a) A Administração provisionando qualquer conta;
        && (
          isAdmin()
          // b) Auto-provisionamento restrito: apenas o próprio documento,
          //    sempre com perfil limitado e aguardando aprovação.
          || (
            userId == request.auth.uid
            && request.resource.data.perfil == 'gerencia'
            && request.resource.data.ativo == false
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.uid == userId
            && (
              !('perfilSolicitado' in request.resource.data)
              || request.resource.data.perfilSolicitado in ['admin', 'projetista', 'engenharia', 'gerencia']
            )
          )
        );

      allow update: if isActiveUser(userId) && (
        // Administração gerencia qualquer conta (perfil, bloqueio, nome);
        isAdmin()
        // O próprio usuário pode alterar apenas o nome — jamais o perfil
        // ou o status (impede auto-escalonamento de privilégios).
        || (
          userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
        )
      );

      // A Administração pode excluir contas (a ação fica registrada em
      // auditoria). O bloqueio (ativo=false) segue como opção padrão, pois
      // preserva o vínculo histórico da conta.
      allow delete: if isAdmin();
    }

    // -------------------- LOGS DE AUDITORIA -------------------------

    match /audit_logs/{logId} {
      allow get, list: if signedIn()
        && isActiveUser(request.auth.uid)
        && userDoc(request.auth.uid).perfil in ['admin', 'gerencia'];

      allow create: if isAdmin()
        // Impede atribuir a autoria da ação a outro usuário.
        && request.resource.data.usuarioUid == request.auth.uid;

      // Logs são imutáveis e indeléveis: nem a administração remove
      // trilhas de auditoria diretamente no banco.
      allow update: if false;
      allow delete: if false;
    }

    // ---------------- COLEÇÕES INDUSTRIAIS (CRUD) -------------------
    // dispositivos, categorias, familias, produtos

    match /dispositivos/{docId} {
      allow get, list: if signedIn();
      allow create: if canCadastrar();
      allow update: if canEditar();
      allow delete: if canExcluir();
    }

    match /categorias/{docId} {
      allow get, list: if signedIn();
      allow create: if canCadastrar();
      allow update: if canEditar();
      allow delete: if canExcluir();
    }

    match /familias/{docId} {
      allow get, list: if signedIn();
      allow create: if canCadastrar();
      allow update: if canEditar();
      allow delete: if canExcluir();
    }

    match /produtos/{docId} {
      allow get, list: if signedIn();
      allow create: if canCadastrar();
      allow update: if canEditar();
      allow delete: if canExcluir();
    }

    // ------------------- REUTILIZAÇÕES ------------------------------
    // Máquina de estados aplicada no servidor (espelha
    // TRANSICOES_REUTILIZACAO em src/domain/entities/reutilizacao.ts).

    match /reutilizacoes/{docId} {
      function stDe() {
        return resource.data.status;
      }

      function stPara() {
        return request.resource.data.status;
      }

      function transicaoProjetista() {
        return (
          (stDe() == 'Em análise (Projetista)'
            && stPara() in ['Reutilização aprovada', 'Reutilização não aprovada'])
          || (stDe() == 'Aguardando novo filtro (Projetista)'
            && stPara() in ['Em análise (Projetista)', 'Liberado para fabricação (novo dispositivo)'])
        );
      }

      function transicaoEngenharia() {
        return (
          (stDe() == 'Em análise (Engenharia)' && stPara() == 'Em análise (Projetista)')
          || (stDe() == 'Reutilização aprovada' && stPara() == 'Em andamento - OS')
          || (stDe() == 'Reutilização não aprovada'
            && stPara() in ['Em andamento - OS', 'Aguardando novo filtro (Projetista)'])
        );
      }

      allow get, list: if signedIn();

      allow create: if isActiveUser(request.auth.uid)
        && request.resource.data.solicitanteId == request.auth.uid
        && (
          // Engenharia inicia o processo (rascunho do 1º filtro).
          (
            userDoc(request.auth.uid).perfil == 'engenharia'
            && request.resource.data.status == 'Em análise (Engenharia)'
          )
          // Administração/Ferramentaria registram histórico diretamente.
          || userDoc(request.auth.uid).perfil in ['admin', 'projetista']
        );

      allow update: if isActiveUser(request.auth.uid)
        && (
          isAdmin()
          || (userDoc(request.auth.uid).perfil == 'projetista' && transicaoProjetista())
          || (userDoc(request.auth.uid).perfil == 'engenharia' && transicaoEngenharia())
        );

      allow delete: if canExcluir();
    }

    // --------------------- NOTIFICAÇÕES ------------------------------
    // Cada documento pertence a um destinatário (destinatarioUid).
    // O status exibido é derivado em tempo real da entidade referenciada
    // (reutilização ou usuário), mantendo a notificação sempre atualizada.

    match /notifications/{notifId} {
      function destUid() {
        return request.resource.data.destinatarioUid;
      }

      function destExiste() {
        return exists(/databases/$(database)/documents/users/$(destUid()));
      }

      function destPerfil() {
        return userDoc(destUid()).perfil;
      }

      // Somente o destinatário lê as próprias notificações.
      allow get, list: if signedIn()
        && resource.data.destinatarioUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.remetenteUid == request.auth.uid
        && (
          // Solicitação de conta com tier != Gerência -> Administração.
          // O remetente é o próprio solicitante (conta recém-criada, inativa),
          // validado pelo perfilSolicitado gravado no seu próprio documento.
          (
            request.resource.data.tipo == 'conta_nova'
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && userDoc(request.auth.uid).perfil == 'gerencia'
            && userDoc(request.auth.uid).perfilSolicitado == request.resource.data.perfilSolicitado
            && destExiste()
            && destPerfil() == 'admin'
          )
          // Demais fluxos exigem remetente com conta ativa.
          || (
            isActiveUser(request.auth.uid)
            && (
              // Nova solicitação de reutilização -> quem pode aprová-la.
              (
                request.resource.data.tipo == 'reutilizacao_nova'
                && destExiste()
                && destPerfil() in ['admin', 'projetista']
              )
              // Decisões (reutilização ou conta) -> destinatário existente.
              || (
                request.resource.data.tipo in ['reutilizacao_decidida', 'conta_decidida']
                && destExiste()
              )
            )
          )
        );

      // O destinatário pode apenas marcar como lida/resolvida.
      allow update: if signedIn()
        && resource.data.destinatarioUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida', 'resolvida']);

      allow delete: if false;
    }
  }
}
