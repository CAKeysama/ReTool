rules_version = '2';

// ReTool — Regras de Segurança do Storage
// Acesso a anexos exige conta operacional; escrita/exclusão respeitam o RBAC
// (cadastro/edição: admin+projetista; exclusão: somente admin).

service firebase.storage {
  match /b/{bucket}/o {
    match /retool/dispositivos/{dispositivoId}/{allPaths=**} {

      function signedIn() {
        return request.auth != null;
      }

      function userDoc() {
        return firestore.get(/databases/(default)/documents/users/(request.auth.uid)).data;
      }

      // Conta operacional: ativa, aprovada, com cargo definido e sem troca
      // de senha pendente (convidados em análise não acessam anexos).
      function isActiveUser() {
        return signedIn()
          && firestore.exists(/databases/(default)/documents/users/(request.auth.uid))
          && userDoc().ativo == true
          && userDoc().get('perfil', '') in ['admin', 'projetista', 'engenharia', 'gerencia']
          && userDoc().get('statusAprovacao', 'aprovado') == 'aprovado'
          && userDoc().get('trocaSenhaObrigatoria', false) != true;
      }

      function canCadastrar() {
        return isActiveUser() && userDoc().perfil in ['admin', 'projetista'];
      }

      function isAdmin() {
        return isActiveUser() && userDoc().perfil == 'admin';
      }

      // Leitura apenas para usuários autenticados com conta ativa.
      allow read: if isActiveUser();

      // Upload com validação de tamanho/tipo, restrito a quem pode cadastrar.
      allow create, update: if canCadastrar()
        && request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(jpeg|png|webp)')
          || request.resource.contentType == 'application/pdf'
        );

      // Exclusão (limpeza em cascata de anexos) apenas pela Administração.
      allow delete: if isAdmin();
    }
  }
}
