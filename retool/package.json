{
  "name": "retool",
  "private": true,
  "version": "2.10.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emuladores": "vite --mode emulador",
    "emuladores": "node scripts/emuladores.mjs iniciar",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "preview": "vite preview",
    "deploy": "npm run build && npx firebase-tools deploy",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:rules": "node scripts/emuladores.mjs regras",
    "test:e2e": "node scripts/emuladores.mjs e2e"
  },
  "dependencies": {
    "firebase": "^12.12.1",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.56.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.32.0",
    "globals": "^17.4.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "vite": "^8.0.4"
  }
}
